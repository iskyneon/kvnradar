# KVNRadar 0.6.8 — optional outbound notifications. Never commit a populated .env.
# Compass Userbot (on-premise): all three values required to enable.
COMPASS_BASE_URL=
COMPASS_BOT_TOKEN=
COMPASS_GROUP_ID=

# Telegram Bot API: token and chat ID required to enable.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Optional override for a custom Telegram API endpoint.
TELEGRAM_API_BASE_URL=https://api.telegram.org

# Optional central / blocklist tuning (defaults shown).
CENTRAL_BLOCKLIST_INTERVAL=300
BLOCKLIST_UPDATE_SECONDS=21600
BLOCKLIST_RESOLVE_DNS=0

# Email notifications (third channel). Leave SMTP_HOST/FROM/TO empty to disable.
# Use TLS with verified server certificates; plaintext SMTP is not supported.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# One or more addresses, separated by commas.
SMTP_TO=
SMTP_TIMEOUT=15
# Optional button link in email. Must be HTTPS, without credentials or query.
SMTP_DASHBOARD_URL=
